# ---- Server ----
PORT=3001
# Random long string used to sign login session tokens
JWT_SECRET=change-me-to-a-long-random-string
# Where the SQLite database file lives
DATABASE_PATH=./data/prospecthunter.db
# Public URL of the frontend (used for OAuth redirect + CORS)
APP_URL=http://localhost:5173
# Public URL of the API (Google redirects back here, unsubscribe links point here)
API_URL=http://localhost:3001

# ---- AI (set ONE of these; auto-detected, or force with LLM_PROVIDER=anthropic|openai) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Gmail OAuth (Google Cloud Console -> OAuth client, type "Web application") ----
# Authorised redirect URI must be: {API_URL}/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Google Places (Places API + Geocoding API enabled on the same key) ----
GOOGLE_PLACES_API_KEY=

# ---- Telegram bot (optional; long-polling, only starts if set) ----
TELEGRAM_BOT_TOKEN=

# ---- Unsubscribe link signing ----
UNSUBSCRIBE_SIGNING_SECRET=change-me-to-a-long-random-string

# ---- Scheduled jobs (cron syntax, server local time) ----
CRON_DAILY_BRIEFING=0 * * * *
CRON_DRIP_FOLLOWUPS=0 8 * * *
CRON_DUE_FOLLOWUPS=0 8 * * *
CRON_WATCHLIST_RESCORE=0 6 * * 1
